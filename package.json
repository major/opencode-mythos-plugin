{
  "name": "@mhayden/opencode-mythos-plugin",
  "version": "0.1.1",
  "description": "Unofficial OpenCode V2 provider plugin for Claude Mythos models using your ant CLI login. Not affiliated with OpenCode or Anthropic.",
  "type": "module",
  "keywords": [
    "unofficial",
    "opencode",
    "opencode-plugin",
    "anthropic",
    "claude",
    "mythos"
  ],
  "author": "Major Hayden <major@mhtx.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/major/opencode-mythos-plugin.git"
  },
  "homepage": "https://github.com/major/opencode-mythos-plugin#readme",
  "bugs": {
    "url": "https://github.com/major/opencode-mythos-plugin/issues"
  },
  "scripts": {
    "build": "bun build src/index.ts --banner \"// Unofficial plugin. Not affiliated with or endorsed by the OpenCode project or Anthropic.\" --outfile dist/index.js --target node --format esm --packages external",
    "test": "bun test ./test",
    "check": "tsc --noEmit",
    "verify:package": "bun scripts/verify-package.ts",
    "prepublishOnly": "bun run check && bun run test && bun run build && bun run verify:package"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.28",
    "@opencode/ai": "^2.0.28",
    "@opencode/schema": "^2.0.28",
    "effect": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/ai": {
      "optional": true
    },
    "@opencode/schema": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/ai": "2.0.28",
    "@opencode/plugin": "2.0.28",
    "@opencode/schema": "2.0.28",
    "@types/bun": "1.4.2",
    "effect": "4.0.2",
    "typescript": "7.0.2"
  }
}
